---
import Layout from '../../layouts/Layout.astro';
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';

interface Extension {
  id: string;
  canvasId: string;
  name: string;
  description: string;
  version: string;
  author?: { name?: string; url?: string } | null;
  keywords: string[];
  platform: string;
  previewUrl: string;
  readmeHtml: string;
  directInstallUrl: string;
  sourceUrl: string;
  pluginName: string;
  marketplaceSource: string;
  marketplaceName: string;
  marketplaceAddUrl: string;
  copilotAppInstallUrl: string;
  vscodeInstallUrl: string;
  vscodeInsidersInstallUrl: string;
  marketplaceAddCommand: string;
  installCommand: string;
}

interface SiteData {
  extensions: Extension[];
}

export function getStaticPaths() {
  const dataPath = resolve('./public/data/data.json');
  if (!existsSync(dataPath)) return [];
  const siteData = JSON.parse(readFileSync(dataPath, 'utf8')) as SiteData;
  return siteData.extensions.map((extension) => ({
    params: { id: extension.id },
    props: { extension },
  }));
}

const { extension } = Astro.props as { extension: Extension };
const base = import.meta.env.BASE_URL;
const vscodeMarketplaceSetting = JSON.stringify(
  { "chat.plugins.marketplaces": [extension.marketplaceSource] },
  null,
  2,
);
---
<Layout
  title={`${extension.name} — DSR Copilot Catalog`}
  description={extension.description}
  currentPage="extensions"
>
  <div class="page-hero">
    <div class="container">
      <a class="extension-detail__back" href={`${base}extensions/`}>← Canvas Extensions</a>
      <h1 class="page-hero__title">{extension.name}</h1>
      <p class="page-hero__description">{extension.description}</p>
    </div>
  </div>

  <main class="extension-detail">
    <div class="container extension-detail__layout">
      <div class="extension-detail__main">
        <section class="extension-detail__preview" aria-labelledby="preview-heading">
          <h2 id="preview-heading">Preview</h2>
          <img
            src={`${base}${extension.previewUrl}`}
            alt={`${extension.name} preview`}
          />
        </section>

        <section class="extension-detail__readme" aria-labelledby="documentation-heading">
          <h2 id="documentation-heading">Documentation</h2>
          <div class="article-content" set:html={extension.readmeHtml} />
        </section>
      </div>

      <aside class="extension-detail__sidebar">
        <section class="install-card">
          <h2>Install</h2>
          <h3>1. Add the marketplace once</h3>
          <p>
            Register <code>{extension.marketplaceSource}</code> before using marketplace installation.
          </p>
          <div class="install__buttons">
            <a
              class="install__button install__button--primary"
              href={extension.marketplaceAddUrl}
              title="Register the marketplace in the GitHub Copilot app"
            >
              Add marketplace in Copilot app
            </a>
            <button
              class="install__button install__button--secondary"
              id="copy-marketplace-command"
              type="button"
              data-command={extension.marketplaceAddCommand}
              title="Copy the GitHub Copilot CLI marketplace command"
            >
              Copy CLI command
            </button>
          </div>
          <details class="install-card__vscode">
            <summary>VS Code and VS Code Insiders setup</summary>
            <p>Add this to the user <code>settings.json</code> in either editor:</p>
            <code>{vscodeMarketplaceSetting}</code>
          </details>

          <h3>2. Install this extension</h3>
          <div class="install__buttons">
            <a
              class="install__button install__button--primary"
              href={extension.copilotAppInstallUrl}
              title="Install in the GitHub Copilot app"
            >
              Copilot app
            </a>
            <a
              class="install__button install__button--secondary"
              href={extension.vscodeInstallUrl}
              title="Install in VS Code"
            >
              VS Code
            </a>
            <a
              class="install__button install__button--secondary"
              href={extension.vscodeInsidersInstallUrl}
              title="Install in VS Code Insiders"
            >
              VS Code Insiders
            </a>
          </div>
          <p>Or run this command in GitHub Copilot CLI:</p>
          <code>{extension.installCommand}</code>
          <button
            class="install__button install__button--primary"
            id="copy-install"
            type="button"
            data-command={extension.installCommand}
          >
            Copy install command
          </button>

          <h3>Direct GitHub installation in the Copilot app</h3>
          <p>
            Choose <strong>Install Plugin from Source</strong> in the GitHub Copilot app, then paste this plugin-folder URL.
          </p>
          <button
            class="install__button install__button--secondary"
            id="copy-extension-url"
            type="button"
            data-url={extension.directInstallUrl}
            title="Copy the GitHub plugin-folder URL"
          >
            Copy GitHub folder URL
          </button>
          <a
            class="install__button install__button--secondary"
            href={extension.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            title="View source"
          >
            Source
          </a>
          <p class="install-card__note">
            Canvas extensions are supported in the GitHub Copilot app only.
          </p>
        </section>

        <dl class="extension-metadata">
          <div><dt>Plugin</dt><dd>{extension.pluginName}</dd></div>
          <div><dt>Canvas ID</dt><dd>{extension.canvasId}</dd></div>
          <div><dt>Version</dt><dd>{extension.version}</dd></div>
          <div><dt>Platform</dt><dd>{extension.platform}</dd></div>
          {extension.author?.name && (
            <div><dt>Author</dt><dd>{extension.author.name}</dd></div>
          )}
        </dl>

      </aside>
    </div>
  </main>
</Layout>

<script>
  const button = document.getElementById('copy-install') as HTMLButtonElement | null;
  const marketplaceButton = document.getElementById('copy-marketplace-command') as HTMLButtonElement | null;
  const urlButton = document.getElementById('copy-extension-url') as HTMLButtonElement | null;

  marketplaceButton?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(marketplaceButton.dataset.command ?? '');
    marketplaceButton.textContent = 'Copied!';
    window.setTimeout(() => {
      marketplaceButton.textContent = 'Copy CLI command';
    }, 2000);
  });

  urlButton?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(urlButton.dataset.url ?? '');
    urlButton.textContent = 'Copied!';
    window.setTimeout(() => {
      urlButton.textContent = 'Copy GitHub folder URL';
    }, 2000);
  });

  button?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(button.dataset.command ?? '');
    button.textContent = 'Copied!';
    window.setTimeout(() => {
      button.textContent = 'Copy install command';
    }, 2000);
  });
</script>
